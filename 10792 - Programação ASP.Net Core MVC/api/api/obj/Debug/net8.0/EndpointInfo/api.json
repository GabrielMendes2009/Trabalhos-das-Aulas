          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "genre": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "studioId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
